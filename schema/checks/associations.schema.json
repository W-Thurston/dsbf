{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "associations",
  "check_id": "associations",
  "check_version": "1.0.0",
  "params": {
    "additionalProperties": false,
    "properties": {
      "method": {
        "default": "auto",
        "description": "The statistic for a numeric pair. `auto` uses Kendall's τ-b below `small_sample` complete rows and Pearson's r from there on.",
        "enum": [
          "auto",
          "pearson",
          "spearman",
          "kendall"
        ],
        "type": "string"
      },
      "small_sample": {
        "default": 30,
        "description": "Complete rows below which `auto` uses Kendall's τ.",
        "minimum": 5,
        "type": "integer"
      },
      "min_n": {
        "default": 8,
        "description": "Complete rows a pair needs. Routing to a statistic happens after this gate, never before it, so a small frame gets Kendall's τ.",
        "minimum": 4,
        "type": "integer"
      },
      "max_levels": {
        "default": 50,
        "description": "Most levels a categorical column may have; η over more levels is inflated by the groups' own noise.",
        "minimum": 2,
        "type": "integer"
      },
      "interval_level": {
        "default": 0.95,
        "description": "Coverage of the Fisher z intervals.",
        "exclusiveMaximum": 1,
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "redundancy_threshold": {
        "default": 0.99,
        "description": "|Pearson r| from which two numeric columns are redundant.",
        "exclusiveMinimum": 0,
        "maximum": 1,
        "type": "number"
      },
      "max_pairs": {
        "default": 10000,
        "description": "Most pairs tested; with more, the check is skipped rather than test an arbitrary part of them.",
        "minimum": 1,
        "type": "integer"
      },
      "max_rows": {
        "default": 200000,
        "description": "Most rows read; a larger frame is sampled with `seed`.",
        "minimum": 1000,
        "type": "integer"
      },
      "seed": {
        "default": 42,
        "description": "Seed of the row sample.",
        "type": "integer"
      },
      "max_findings": {
        "default": 50,
        "description": "Most findings; the redundant and strongest pairs first.",
        "minimum": 1,
        "type": "integer"
      }
    },
    "title": "AssociationsParams",
    "type": "object"
  },
  "output": {
    "$defs": {
      "Interval": {
        "additionalProperties": false,
        "description": "A confidence interval for a statistic.",
        "properties": {
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "level": {
            "description": "Coverage, for example 0.95.",
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "low",
          "high",
          "level",
          "method"
        ],
        "title": "Interval",
        "type": "object"
      },
      "PairAssociation": {
        "additionalProperties": false,
        "properties": {
          "first": {
            "type": "string"
          },
          "second": {
            "type": "string"
          },
          "metric": {
            "enum": [
              "pearson_r",
              "spearman_r",
              "kendalls_tau",
              "eta"
            ],
            "type": "string"
          },
          "value": {
            "description": "Signed for r, ρ and τ; η is between 0 and 1 and has no sign.",
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          },
          "strength": {
            "description": "The band of |value| on the scale of `metric`.",
            "enum": [
              "negligible",
              "weak",
              "moderate",
              "strong"
            ],
            "type": "string"
          },
          "interval": {
            "anyOf": [
              {
                "$ref": "#/$defs/Interval"
              },
              {
                "type": "null"
              }
            ],
            "description": "Fisher z interval; None for η and for a pair too small for one."
          },
          "n_used": {
            "description": "Rows where both columns have a value.",
            "minimum": 0,
            "type": "integer"
          },
          "pearson_r": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": -1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "For a numeric pair, whatever `metric` is."
          }
        },
        "required": [
          "first",
          "second",
          "metric",
          "value",
          "strength",
          "interval",
          "n_used",
          "pearson_r"
        ],
        "title": "PairAssociation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "pairs": {
        "description": "Every pair that was tested.",
        "items": {
          "$ref": "#/$defs/PairAssociation"
        },
        "type": "array"
      },
      "pairs_tested": {
        "minimum": 0,
        "type": "integer"
      },
      "pairs_flagged": {
        "description": "Pairs that are redundant or in the strong band.",
        "minimum": 0,
        "type": "integer"
      },
      "untested": {
        "additionalProperties": {
          "type": "integer"
        },
        "description": "Pairs not tested, by reason: too_few_rows, too_few_groups, no_variation or overflow.",
        "type": "object"
      },
      "skipped_columns": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Categorical columns left out, with the reason.",
        "type": "object"
      },
      "rows_used": {
        "description": "Rows read, after any sampling.",
        "minimum": 0,
        "type": "integer"
      },
      "rows_total": {
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "pairs",
      "pairs_tested",
      "pairs_flagged",
      "untested",
      "skipped_columns",
      "rows_used",
      "rows_total"
    ],
    "title": "AssociationsOutput",
    "type": "object"
  }
}
