{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stationarity",
  "check_id": "stationarity",
  "check_version": "1.1.0",
  "params": {
    "additionalProperties": false,
    "properties": {
      "time_index": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The datetime column that orders the rows. `dsbf.profile(time_index=...)` sets it; without one the check is not applicable."
      },
      "frequency": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The spacing of the series, as an offset alias: a count and a unit (`D`, `h`, `min`, `s`, `ms`, `W`: fixed spans; `MS`, `ME`, `QS`, `QE`, `YS`, `YE`: calendar months), such as `15min` or `2W`. Unset, the spacing the profile found in the index is used."
      },
      "aggregate": {
        "default": "mean",
        "description": "How the values of one period are combined, which is what repeated timestamps and rows finer than the frequency need.",
        "enum": [
          "mean",
          "median",
          "sum",
          "last"
        ],
        "type": "string"
      },
      "max_periods": {
        "default": 2000,
        "description": "Most periods used: the most recent ones. Tests on tens of thousands of points reject trivial deviations, and the cost of the lag regressions grows with them.",
        "maximum": 100000,
        "minimum": 30,
        "type": "integer"
      },
      "max_fill_share": {
        "default": 0.2,
        "description": "Largest share of a series' periods that may be empty and interpolated; a column with more has no series.",
        "maximum": 0.9,
        "minimum": 0,
        "type": "number"
      },
      "value_columns": {
        "default": [],
        "description": "The numeric columns to analyse; empty is every numeric column.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "alpha": {
        "default": 0.05,
        "description": "Significance level of both tests.",
        "exclusiveMaximum": 1,
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "max_lag": {
        "default": 24,
        "description": "Most lags of the ADF regression, from which AIC picks, and of the KPSS long-run variance. statsmodels' own default grows with the series and every candidate lag is a regression.",
        "maximum": 365,
        "minimum": 1,
        "type": "integer"
      },
      "min_periods": {
        "default": 20,
        "description": "Periods a series needs to be tested.",
        "minimum": 10,
        "type": "integer"
      }
    },
    "title": "StationarityParams",
    "type": "object"
  },
  "output": {
    "$defs": {
      "ColumnStationarity": {
        "additionalProperties": false,
        "properties": {
          "periods": {
            "description": "Periods in the series: its length.",
            "minimum": 1,
            "type": "integer"
          },
          "periods_filled": {
            "description": "Empty periods filled by linear interpolation.",
            "minimum": 0,
            "type": "integer"
          },
          "rows_used": {
            "description": "Rows whose value entered the series.",
            "minimum": 1,
            "type": "integer"
          },
          "series_start": {
            "description": "Start of the first period, UTC.",
            "type": "string"
          },
          "adf": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnitRootTest"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null hypothesis: a unit root. Rejecting it favours stationarity."
          },
          "kpss": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnitRootTest"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null hypothesis: stationary around a level. Rejecting it favours a drifting level."
          },
          "adf_trend": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnitRootTest"
              },
              {
                "type": "null"
              }
            ],
            "description": "ADF with a constant and a linear trend in the regression."
          },
          "kpss_trend": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnitRootTest"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null hypothesis: stationary around a linear trend."
          },
          "errors": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tests that could not run, and why.",
            "type": "object"
          },
          "assessment": {
            "enum": [
              "consistent_with_stationary",
              "consistent_with_trend_stationary",
              "consistent_with_non_stationary",
              "ambiguous_trend_stationary_or_structural_break",
              "inconclusive",
              "indeterminate"
            ],
            "type": "string"
          },
          "confidence": {
            "enum": [
              "moderate",
              "low"
            ],
            "type": "string"
          },
          "max_lag": {
            "description": "The cap on lags for this series' length.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "periods",
          "periods_filled",
          "rows_used",
          "series_start",
          "adf",
          "kpss",
          "adf_trend",
          "kpss_trend",
          "errors",
          "assessment",
          "confidence",
          "max_lag"
        ],
        "title": "ColumnStationarity",
        "type": "object"
      },
      "UnitRootTest": {
        "additionalProperties": false,
        "properties": {
          "test": {
            "enum": [
              "adf",
              "kpss"
            ],
            "type": "string"
          },
          "statistic": {
            "type": "number"
          },
          "p_value": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "p_value_limit": {
            "anyOf": [
              {
                "enum": [
                  "at_most",
                  "at_least"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "KPSS reads its p-value from a table between 0.01 and 0.1; outside it the value is a bound, not an estimate."
          },
          "lags": {
            "description": "Lags the test used.",
            "minimum": 0,
            "type": "integer"
          },
          "critical_values": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "rejects": {
            "description": "p is below `alpha`.",
            "type": "boolean"
          }
        },
        "required": [
          "test",
          "statistic",
          "p_value",
          "p_value_limit",
          "lags",
          "critical_values",
          "rejects"
        ],
        "title": "UnitRootTest",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "index": {
        "description": "The datetime column that ordered the rows.",
        "type": "string"
      },
      "frequency": {
        "description": "The period of every series, as an alias.",
        "type": "string"
      },
      "frequency_source": {
        "enum": [
          "configured",
          "profile"
        ],
        "type": "string"
      },
      "aggregate": {
        "description": "How the values of one period combine.",
        "enum": [
          "mean",
          "median",
          "sum",
          "last"
        ],
        "type": "string"
      },
      "max_periods": {
        "description": "Most recent periods used.",
        "minimum": 1,
        "type": "integer"
      },
      "periods_total": {
        "description": "Periods the index spans, before the cut to `max_periods`.",
        "minimum": 1,
        "type": "integer"
      },
      "truncated": {
        "description": "The index spans more than `max_periods`.",
        "type": "boolean"
      },
      "timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Time zone of the index; instants are read as UTC."
      },
      "skipped": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Columns with no result, and why.",
        "type": "object"
      },
      "alpha": {
        "type": "number"
      },
      "columns": {
        "additionalProperties": {
          "$ref": "#/$defs/ColumnStationarity"
        },
        "description": "Every column that was tested, by name.",
        "type": "object"
      }
    },
    "required": [
      "index",
      "frequency",
      "frequency_source",
      "aggregate",
      "max_periods",
      "periods_total",
      "truncated",
      "timezone",
      "skipped",
      "alpha",
      "columns"
    ],
    "title": "StationarityOutput",
    "type": "object"
  }
}
