{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "missingness_mechanism",
  "check_id": "missingness_mechanism",
  "check_version": "1.0.0",
  "params": {
    "additionalProperties": false,
    "properties": {
      "alpha": {
        "default": 0.05,
        "description": "Level of the adjusted p-value for a dependence.",
        "exclusiveMaximum": 1,
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "correction": {
        "default": "fdr_bh",
        "description": "Adjustment of the p-values for the number of tests run over all the columns with nulls and all their predictors. `fdr_bh` controls the false discovery rate.",
        "enum": [
          "fdr_bh",
          "bonferroni",
          "holm",
          "none"
        ],
        "type": "string"
      },
      "min_effect": {
        "default": 0.1,
        "description": "Effect size (|rank-biserial r| or Cramér's V) from which a significant test is reported; a huge sample makes a weak dependence significant.",
        "exclusiveMaximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "min_null_share": {
        "default": 0.01,
        "description": "Share of rows that must be null for a column to be analysed.",
        "exclusiveMaximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "min_group_n": {
        "default": 8,
        "description": "Rows each of the missing and observed groups needs for a test.",
        "minimum": 2,
        "type": "integer"
      },
      "max_levels": {
        "default": 20,
        "description": "Most levels a categorical predictor may have.",
        "minimum": 2,
        "type": "integer"
      },
      "max_subjects": {
        "default": 30,
        "description": "Most columns with nulls analysed, those with most nulls first.",
        "minimum": 1,
        "type": "integer"
      },
      "max_rows": {
        "default": 200000,
        "description": "Most rows read; a larger frame is sampled with `seed`.",
        "minimum": 1000,
        "type": "integer"
      },
      "seed": {
        "default": 42,
        "description": "Seed of the row sample.",
        "type": "integer"
      },
      "max_listed": {
        "default": 10,
        "description": "Most dependences listed for one column.",
        "minimum": 1,
        "type": "integer"
      },
      "min_report_share": {
        "default": 0.05,
        "description": "Null share from which a column with no dependence found is still reported as a finding.",
        "exclusiveMaximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "warn_null_share": {
        "default": 0.2,
        "description": "Null share above which a strong dependence is a warning.",
        "exclusiveMaximum": 1,
        "exclusiveMinimum": 0,
        "type": "number"
      }
    },
    "title": "MissingnessMechanismParams",
    "type": "object"
  },
  "output": {
    "$defs": {
      "MissingColumn": {
        "additionalProperties": false,
        "properties": {
          "n_used": {
            "description": "Rows read.",
            "minimum": 1,
            "type": "integer"
          },
          "n_missing": {
            "minimum": 1,
            "type": "integer"
          },
          "null_share": {
            "exclusiveMinimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "assessment": {
            "enum": [
              "depends_on_observed",
              "no_dependence_found",
              "untestable"
            ],
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why a column is `untestable`."
          },
          "tests_run": {
            "minimum": 0,
            "type": "integer"
          },
          "tests_flagged": {
            "minimum": 0,
            "type": "integer"
          },
          "dependences": {
            "description": "The predictors with a flagged test, the largest effect first.",
            "items": {
              "$ref": "#/$defs/Predictor"
            },
            "type": "array"
          },
          "strongest": {
            "anyOf": [
              {
                "$ref": "#/$defs/Predictor"
              },
              {
                "type": "null"
              }
            ],
            "description": "The largest effect among all the tests, flagged or not."
          },
          "missing_with": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Columns that are null in the same rows (Jaccard of at least 0.5), from the profile.",
            "type": "object"
          }
        },
        "required": [
          "n_used",
          "n_missing",
          "null_share",
          "assessment",
          "reason",
          "tests_run",
          "tests_flagged",
          "dependences",
          "strongest",
          "missing_with"
        ],
        "title": "MissingColumn",
        "type": "object"
      },
      "Predictor": {
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "string"
          },
          "test": {
            "enum": [
              "mann_whitney",
              "chi_squared"
            ],
            "type": "string"
          },
          "n_missing": {
            "description": "Rows of the test where the column is null.",
            "minimum": 1,
            "type": "integer"
          },
          "n_observed": {
            "description": "Rows of the test where it is not.",
            "minimum": 1,
            "type": "integer"
          },
          "statistic": {
            "description": "z for Mann–Whitney, χ² for chi-squared.",
            "type": "number"
          },
          "p_value": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "p_adjusted": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "effect_name": {
            "enum": [
              "rank_biserial",
              "cramers_v"
            ],
            "type": "string"
          },
          "effect": {
            "description": "Rank-biserial r, positive when the predictor is higher where the column is null; or Cramér's V (bias-corrected).",
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          },
          "flagged": {
            "type": "boolean"
          }
        },
        "required": [
          "column",
          "test",
          "n_missing",
          "n_observed",
          "statistic",
          "p_value",
          "p_adjusted",
          "effect_name",
          "effect",
          "flagged"
        ],
        "title": "Predictor",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "columns": {
        "additionalProperties": {
          "$ref": "#/$defs/MissingColumn"
        },
        "description": "Each analysed column with nulls, by name.",
        "type": "object"
      },
      "tests_run": {
        "minimum": 0,
        "type": "integer"
      },
      "tests_flagged": {
        "minimum": 0,
        "type": "integer"
      },
      "correction": {
        "enum": [
          "fdr_bh",
          "bonferroni",
          "holm",
          "none"
        ],
        "type": "string"
      },
      "rows_used": {
        "minimum": 0,
        "type": "integer"
      },
      "skipped_columns": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Columns with nulls that were not analysed, with the reason.",
        "type": "object"
      },
      "unusable_predictors": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Columns left out as predictors, with the reason.",
        "type": "object"
      }
    },
    "required": [
      "columns",
      "tests_run",
      "tests_flagged",
      "correction",
      "rows_used",
      "skipped_columns",
      "unusable_predictors"
    ],
    "title": "MissingnessMechanismOutput",
    "type": "object"
  }
}
